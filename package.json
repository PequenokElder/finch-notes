{
  "name": "finch",
  "productName": "Finch",
  "version": "0.1.0",
  "description": "A calm, local markdown notes app with beautiful PDF export.",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --watch & electron .",
    "package": "node build.mjs && electron-packager . Finch --platform=darwin --arch=$(node -p process.arch) --out=release --overwrite --icon=build/icon.icns --app-bundle-id=com.finch.notes --ignore=\"^/src\" --ignore=\"^/release\" --ignore=\"^/build\" --ignore=\"^/build.mjs\" --ignore=\"^/README.md\" --ignore=\"^/scripts\"",
    "install-app": "sh scripts/install-app.sh"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "@electron/packager": "^18.3.6",
    "@lezer/highlight": "^1.2.1",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.0"
  }
}
